{
  "name": "shared",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p . && node --input-type=module -e \"import fs from 'node:fs'; fs.readdirSync('dist').filter(f=>f.endsWith('.js')).forEach(f=>fs.copyFileSync('dist/'+f, 'src/'+f))\""
  },
