{
  "name": "qlyvora",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace shared run build && npm --workspace client run build && npm --workspace server run build",
    "build:shared": "npm --workspace shared run build",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "start": "node server/dist/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.0",
    "vitest": "^5.0.3"
  }
}
