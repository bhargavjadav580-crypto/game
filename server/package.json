{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc -p . && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/questions/data', 'dist/questions/data', { recursive: true, force: true })\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.5",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0"
  }
}
